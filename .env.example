# Copy this file to .env and customize before running `docker compose up`.
# Uncomment a variable to override its default (shown in the comment).
# See docker-compose.yml for how each variable is used and
# client/README.md for what the rtl_fm/multimon-ng variables map to.

# Shared
# TZ=America/Chicago

# SECURE_COOKIES marks the session and CSRF cookies `secure`, so browsers only
# send them over HTTPS. Normally you do not need this: it is derived from the
# scheme of the Site URL set in Admin → Settings → Global. Set it explicitly if
# you terminate TLS somewhere the server cannot infer, or set it to false to
# recover access if an https Site URL locked you out of an http instance.
# SECURE_COOKIES=true

# ── Instance 1 ───────────────────────────────────────────────────────────

# SERVER1

# SERVER1_PORT=3001
# Docker sets HOSTNAME to the container ID by default, not a real domain -
# set this to the server's public domain (with or without a URL scheme,
# e.g. "pager1.example.com", "https://pager1.example.com", "http://192.168.1.30:3000" all work) so
# Discord webhook will function correctly.
# HOSTNAME1=https://pager1.example.com
# USE_COOKIE_HOST1 makes the session cookie valid across subdomains of
# HOSTNAME1 (set the domain attribute to ".<host>") - useful if you access
# PagerMon through more than one hostname/subdomain behind a reverse proxy.
# Leave unset for a normal single-hostname setup.
# USE_COOKIE_HOST1=true
# PAGERMON_URL1 is the external address users reach this instance on, and it
# must include the scheme. Links in password-reset emails are built from it.
# It overrides the Site URL field in Admin → Settings → Global; either one works,
# but one of them must be set before self-service password reset can be enabled.
# It is deliberately never taken from the request's Host header, which an
# attacker can forge to put their own address into a genuine reset email.
# PAGERMON_URL1=https://pager1.example.com

# CLIENT 1

# PAGERMON_SERVER1=http://pagermon-server1:3000
# API_KEY1=changeme               # must match a key in server1's config.json
# CLIENT1_IDENTIFIER=CLIENT1

#RTL_FM

# RTL_FREQ1=453.600M
# RTL_DEVICE1=0
# RTL_SQUELCH1=0
# RTL_GAIN1=
# RTL_PPM1=
# RTL_BIAS_TEE1=true
# RTL_FM_EXTRA_ARGS1=

#MULTIMON 

# MULTIMON_PROTOCOL1=POCSAG1200
# MULTIMON_B1=2
# MULTIMON_INVERT1=true
# MULTIMON_HIDE_EMPTY1=false
# MULTIMON_QUIET1=true
# MULTIMON_VERBOSITY1=
# MULTIMON_EXTRA_ARGS1=

# ── Instance 2 ───────────────────────────────────────────────────────────
# SERVER2_PORT=3002

# HOSTNAME2=https://pager2.example.com
# USE_COOKIE_HOST2=true
# PAGERMON_URL2=https://pager2.example.com

# PAGERMON_SERVER2=http://pagermon-server2:3000
# API_KEY2=changeme
# CLIENT2_IDENTIFIER=CLIENT2

# RTL_FREQ2=462.950M
# RTL_DEVICE2=1
# RTL_SQUELCH2=0
# RTL_GAIN2=
# RTL_PPM2=
# RTL_BIAS_TEE2=true
# RTL_FM_EXTRA_ARGS2=

# MULTIMON_PROTOCOL2=POCSAG1200
# MULTIMON_B2=2
# MULTIMON_INVERT2=true
# MULTIMON_HIDE_EMPTY2=false
# MULTIMON_QUIET2=true
# MULTIMON_VERBOSITY2=
# MULTIMON_EXTRA_ARGS2=
